# Copier vers backend/.env (ne jamais committer .env)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Médias publics (prod : https://votre-domaine.com)
PUBLIC_BASE_URL=

# Optionnel — tâches async
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

OTP_SMS_EXPIRY_SECONDS=300
# True uniquement si un fournisseur SMS payant est configure
OTP_SMS_ENABLED=False
# Gratuit par defaut : auto (email si pas de SMS), email, sms, console
OTP_DELIVERY=auto
OTP_EMAIL_ENABLED=True

# Email SMTP gratuit (Gmail, Brevo, etc.) — OTP + alertes sans Firebase
# Dev : laissez vide pour afficher les emails dans la console Django
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tekisa <noreply@tekisa.local>

# SMS payant optionnel : console (dev), africastalking, twilio
SMS_PROVIDER=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER=TEKISA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
